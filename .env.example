# =============================================================================
# CyberSafe24 Shield – Umgebungsvariablen
# Niemals echte Schlüssel committen. Produktion: Secrets im Vercel-/Docker-Secret-Store.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR serverseitig (Next.js Server / Worker). Niemals mit NEXT_PUBLIC_ präfixen!
SUPABASE_SERVICE_ROLE_KEY=

# 32 Byte, base64 (z. B. `openssl rand -base64 32`). Verschlüsselt Breach-Konten, hasht IPs.
DATA_ENCRYPTION_KEY=

# --- E-Mail (Resend) – optional, ohne Werte wird nichts versendet ---------------
RESEND_API_KEY=
EMAIL_FROM="CyberSafe24 Shield <alerts@example.com>"
SUPPORT_EMAIL=support@cybersafe24.de

# --- Stripe – optional, ohne Werte ist Checkout deaktiviert ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SHIELD=
STRIPE_PRICE_SHIELD_CARE=

# --- Datenquellen -------------------------------------------------------------
# Have I Been Pwned (kostenpflichtiger API-Schlüssel, Domain muss im HIBP-Dashboard verifiziert sein)
HIBP_API_KEY=
# Nur mit Pro-Tarif: Stealer-Log-Endpunkte nutzen
HIBP_STEALER_LOGS=false
# Shodan InternetDB: "enterprise" (lizenziert, kommerziell) | "evaluation" (nur Entwicklung, nicht in Produktion)
SHODAN_INTERNETDB_LICENSE=
# Cert Spotter (optional, höheres Kontingent)
CERTSPOTTER_API_KEY=

# --- Scanner-Binaries ---------------------------------------------------------
SUBFINDER_BIN=subfinder
SUBFINDER_PROVIDER_CONFIG=
NUCLEI_ENABLED=false
NUCLEI_BIN=nuclei
# Kommagetrennte, geprüfte und freigegebene Template-IDs (nicht-destruktiv)
NUCLEI_TEMPLATE_IDS=

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_ID=
# Nur in Umgebungen mit TLS-terminierendem Egress-Proxy setzen (verhindert Fehlinterpretation)
TLS_INTERCEPT_ISSUER_PATTERN=

# --- Demo ---------------------------------------------------------------------
DEMO_USER_EMAIL=demo@cybersafe24-demo.example
DEMO_USER_PASSWORD=

# --- Notfall ------------------------------------------------------------------
# Nur setzen, wenn ein vertraglich angebundener Experte existiert (wird dann im Emergency Desk angezeigt)
EMERGENCY_PARTNER_NAME=
EMERGENCY_PARTNER_PHONE=
EMERGENCY_PARTNER_EMAIL=
EMERGENCY_PARTNER_HOURS=
